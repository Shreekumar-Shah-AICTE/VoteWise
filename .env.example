# Environment Variables for VoteWise
# Copy this file to .env.local and fill in your values

# Google Gemini AI API Key (required for AI assistant)
# Get yours at: https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key (required for polling station finder)
# Get yours at: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Cloud Translation API Key (required for multi-language support)
# Uses the same Google Cloud API key as Maps
NEXT_PUBLIC_GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Google Cloud Project ID (for Cloud Run deployment)
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here
